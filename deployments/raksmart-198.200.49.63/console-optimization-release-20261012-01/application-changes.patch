+           '{"name":"Server fixed","type":"direct"}]\n'
+           'proxy-groups:\n  - name: STATIC-SELECT\nrules:\n  - MATCH,DIRECT\n')
+TEST_TOKEN = "test-only-capability-token-1234567890"
