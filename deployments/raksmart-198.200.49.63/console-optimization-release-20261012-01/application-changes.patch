+        self.last_enforced = None
+
+    def _record(self, user_id):
+        if not isinstance(user_id, str) or not IDENTITY.fullmatch(user_id):
+            raise _server().PanelError("没有找到这个用户。", 404)
+        return self.accounts._record(user_id)
