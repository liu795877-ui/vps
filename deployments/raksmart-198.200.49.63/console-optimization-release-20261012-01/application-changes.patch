+def _compat_unlink_if_exists(path):
+    # Path.unlink(missing_ok=True) was introduced after Python 3.6.
+    try:
+        path.unlink()
+    except FileNotFoundError:
+        pass
+
+
+if __name__ == "__main__":
+    main()
