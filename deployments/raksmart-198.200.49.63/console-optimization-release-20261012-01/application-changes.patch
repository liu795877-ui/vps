+    def test_existing_profile_health_check_upgrade_preserves_nodes_rules_and_other_groups(self):
+        current = compose(generated("services"))
+        start, end, inline, body = accelerated._section(current, "proxy-groups")
+        groups = json.loads(inline)
+        previous = next(group for group in groups if group["name"] == accelerated.AUTO)
+        previous.update(url="https://api.ipify.org", interval=60, lazy=True)
+        previous.pop("expected-status")
+        previous.pop("timeout")
