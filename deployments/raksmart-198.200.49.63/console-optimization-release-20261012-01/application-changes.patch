+class Controls:
+    def __init__(self):
+        self.calls = []
+        self.fail_once = False
+
+    def apply(self, blocked, rates):
+        self.calls.append((set(blocked), dict(rates)))
+        if self.fail_once:
+            self.fail_once = False
+            raise RuntimeError("kernel refused update")
