+            os.chmod(str(directory), 0o710)
+            for path in (certificate, key):
+                os.chown(str(path), 0, group)
+                os.chmod(str(path), 0o640)
+
+    @staticmethod
+    def service(record):
+        if record["port"] not in PORTS:
+            raise ValueError("Unsupported HY2 service")
