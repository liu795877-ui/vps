+    def _query(self, record):
+        port = record["port"]
+        service = "xray.service" if record["id"] == "admin" else "xray-panel@" + record["id"] + ".service"
+        epoch_result = self.runner(["systemctl", "show", service, "--property=MainPID",
+                                   "--property=ExecMainStartTimestampMonotonic"])
+        epoch = epoch_result.stdout.decode("utf-8", "replace").strip()
+        result = self.runner([str(_server().base.XRAY), "api", "statsquery",
+                              "--server=127.0.0.1:" + str(entrances.private_port(port, "xray_stats")), "-timeout", "3",
+                              "-pattern", "user>>>"])
+        data = _json_output(result.stdout.decode("utf-8", "replace"))
+        counters = {}
+        for stat in data.get("stat", []):
+            name = stat.get("name", "")
+            if re.fullmatch(r"user>>>[^\r\n]+>>>traffic>>>(uplink|downlink)", name):
+                value = int(stat.get("value", 0))
+                if value < 0:
+                    raise ValueError("Negative Xray counter")
+                counters[name] = value
+        # A newly configured, unused instance legitimately returns no counters.
+        result = self.runner(["ss", "-Hnt", "state", "established", "( sport = :" + str(port) + " )"])
+        connections = len([line for line in result.stdout.decode("utf-8", "replace").splitlines()
+                           if line.strip()])
+        return counters, connections, epoch
+
+    def _source_entry(self, entry, name):
+        sources = entry.setdefault("sources", {})
+        if name not in sources:
+            # Migrate existing Xray baselines without re-adding their lifetime
+            # counters to the already persisted monthly total.
+            sources[name] = ({"counters": copy.deepcopy(entry["counters"]),
+                              "sample_time": entry.get("sample_time"), "epoch": entry.get("epoch")}
+                             if name == "xray" else {"counters": {}, "sample_time": None, "epoch": None})
+        return sources[name]
+
+    def _providers(self, record):
+        providers = [("xray", self._query)]
+        if self.hy2 is not None and (not hasattr(self.hy2, "has_record") or self.hy2.has_record(record)):
+            providers.append(("hy2", self.hy2.query))
+        return providers
+
+    def _sample_record(self, record, sampled):
+        user_id = record["id"]
+        entry = self._entry(user_id)
+        month = entry["months"].setdefault(self._month(), {"up_bytes": 0, "down_bytes": 0})
+        live_sources = {}
+        for name, query in self._providers(record):
+            source = self._source_entry(entry, name)
+            try:
+                counters, connections, epoch = query(record)
+                if (not isinstance(counters, dict) or len(counters) > 64 or type(connections) is not int
+                        or connections < 0 or not isinstance(epoch, str) or len(epoch) > 500):
+                    raise ValueError("Invalid source statistics")
+                pattern = (r"hy2>>>traffic>>>(uplink|downlink)" if name == "hy2" else
+                           r"user>>>[^\r\n]+>>>traffic>>>(uplink|downlink)")
+                if any(not isinstance(key, str) or len(key) > 500 or not re.fullmatch(pattern, key)
+                       or type(value) is not int or not 0 <= value < 10 ** 20
+                       for key, value in counters.items()):
+                    raise ValueError("Invalid source counters")
+                restarted = source.get("epoch") is not None and source["epoch"] != epoch
+                deltas = {"up_bytes": 0, "down_bytes": 0}
+                for key, current in counters.items():
+                    previous = source["counters"].get(key)
+                    delta = current if restarted or previous is None or current < previous else current - previous
+                    direction = "up_bytes" if key.endswith(">>>uplink") else "down_bytes"
+                    deltas[direction] += delta
+                previous_time = source.get("sample_time")
+                elapsed = sampled - previous_time if previous_time is not None else 0
+                live_sources[name] = {"available": True, "reason": None, "connections": connections,
+                    "up_rate": int(deltas["up_bytes"] / elapsed) if elapsed > 0 else 0,
+                    "down_rate": int(deltas["down_bytes"] / elapsed) if elapsed > 0 else 0,
+                    "sampled_at": datetime.fromtimestamp(sampled, timezone.utc).isoformat(),
+                    "connection_unit": "QUIC 会话" if name == "hy2" else "TCP 连接"}
