+class ExistingRaksmartNodeTests(unittest.TestCase):
+    def setUp(self):
+        self.temporary = tempfile.TemporaryDirectory(prefix="raksmart-adoption-test-")
+        self.addCleanup(self.temporary.cleanup)
+        self.directory = Path(self.temporary.name)
+        self.identity = "22d0b41d-2eec-437b-b87d-e3e1a64d88a6"
+        self.private = base64.urlsafe_b64encode(bytes(range(32))).decode().rstrip("=")
+        self.public = base64.urlsafe_b64encode(bytes(range(32, 64))).decode().rstrip("=")
+        self.short = "0123456789abcdef"
+        self.config = self.directory / "xray.json"
+        self.source_profile = self.directory / "base.private.yaml"
+        self.original = base.server_config(self.identity, self.private, self.short,
+                                           target="www.cloudflare.com")
+        self.config.write_bytes(server.json_bytes(self.original))
+        self.source_profile.write_text(base.client_profile(
+            "8.8.8.8", self.identity, self.public, self.short, target="www.cloudflare.com"
+        ), encoding="utf-8")
+
+    def adopt(self):
+        return server.Manager(self.directory / "data", "8.8.8.8", self.config,
+                              self.source_profile)
+
+    def test_adopt_443_ipv4_without_replacing_existing_node_then_extend(self):
+        before = self.config.read_bytes()
+        manager = self.adopt()
+        self.assertEqual(self.config.read_bytes(), before)
+        self.assertEqual(manager.state["base"], self.original)
+        self.assertEqual(self.original["inbounds"][0]["port"], 443)
+        self.assertEqual(self.original["outbounds"][0]["settings"],
+                         {"domainStrategy": "UseIPv4"})
+        exit_id = manager.edit_exit({"name": "Test static exit", "address": "8.8.4.4",
+                                     "port": 1080, "auth": "none", "username": "",
+                                     "password": "", "expected_ip": ""})["id"]
+        extended, profile = manager.build(manager.state, exit_id)
+        primary = extended["inbounds"][0]["settings"]["clients"][0]
+        self.assertEqual({key: value for key, value in primary.items() if key != "email"},
+                         self.original["inbounds"][0]["settings"]["clients"][0])
+        self.assertEqual(primary["email"], "panel-primary@stats.invalid")
+        self.assertEqual(len(extended["inbounds"]), 1)
+        self.assertEqual(extended["api"], {"tag": "panel-stats-api",
+                         "listen": "127.0.0.1:15443", "services": ["StatsService"]})
+        self.assertEqual(extended["inbounds"][0]["streamSettings"],
+                         self.original["inbounds"][0]["streamSettings"])
+        self.assertEqual(extended["outbounds"][:2], self.original["outbounds"])
+        self.assertEqual(extended["routing"]["rules"][0], self.original["routing"]["rules"][0])
+        self.assertIn("port: 443", profile)
+        self.assertIn('servername: "www.cloudflare.com"', profile)
+        self.assertEqual(self.config.read_bytes(), before)
+
+    def test_adoption_rejects_unexpected_port_or_direct_outbound(self):
+        changed_port = copy.deepcopy(self.original)
+        changed_port["inbounds"][0]["port"] = 8443
+        changed_direct = copy.deepcopy(self.original)
+        changed_direct["outbounds"][0]["settings"]["domainStrategy"] = "UseIPv6"
+        for candidate in (changed_port, changed_direct):
+            payload = server.json_bytes(candidate)
+            self.config.write_bytes(payload)
+            with self.assertRaises(RuntimeError):
+                self.adopt()
+            self.assertEqual(self.config.read_bytes(), payload)
+            self.assertFalse((self.directory / "data" / "state.private.json").exists())
 
 
