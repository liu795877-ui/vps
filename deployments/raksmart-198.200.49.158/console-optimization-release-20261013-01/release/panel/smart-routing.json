  "dns": {
    "enable": true,
    "enhanced-mode": "fake-ip",
    "fake-ip-range": "198.18.0.1/16",
    "ipv6": false,
    "use-hosts": true,
    "use-system-hosts": true,
    "default-nameserver": [
      "https://223.5.5.5/dns-query"
    ],
    "proxy-server-nameserver": [
      "https://223.5.5.5/dns-query#DIRECT"
    ],
    "direct-nameserver": [
      "https://223.5.5.5/dns-query#DIRECT",
      "https://1.12.12.12/dns-query#DIRECT"
    ],
    "direct-nameserver-follow-policy": true,
    "nameserver": [
      "https://1.1.1.1/dns-query#STATIC-SELECT",
      "https://8.8.8.8/dns-query#STATIC-SELECT"
    ],
    "nameserver-policy": {
      "rule-set:Custom Direct": [
        "https://223.5.5.5/dns-query#DIRECT",
        "https://1.12.12.12/dns-query#DIRECT"
      ],
      "rule-set:Custom Proxy": [
        "https://1.1.1.1/dns-query#STATIC-SELECT",
        "https://8.8.8.8/dns-query#STATIC-SELECT"
      ],
      "rule-set:Overseas Exceptions,IQ International,WeTV": [
        "https://1.1.1.1/dns-query#STATIC-SELECT",
        "https://8.8.8.8/dns-query#STATIC-SELECT"
      ],
      "rule-set:Domestic Media Supplements,Bilibili,IQIYI,Tencent Video,Youku,Mango TV,CCTV,Douyin,Kuaishou,Douyu,Huya,Netease Music,Kugou Kuwo": [
        "https://223.5.5.5/dns-query#DIRECT",
        "https://1.12.12.12/dns-query#DIRECT"
      ],
      "rule-set:Netflix,Disney,YouTube,Telegram,Discord,AI Services,Overseas": [
        "https://1.1.1.1/dns-query#STATIC-SELECT",
        "https://8.8.8.8/dns-query#STATIC-SELECT"
      ],
      "rule-set:China Domains": [
        "https://223.5.5.5/dns-query#DIRECT",
        "https://1.12.12.12/dns-query#DIRECT"
      ],
      "+.cn": [
        "https://223.5.5.5/dns-query#DIRECT",
        "https://1.12.12.12/dns-query#DIRECT"
      ]
    },
    "fake-ip-filter": [
      "localhost",
      "*.localhost",
      "*.lan",
      "*.local",
      "*.localdomain",
      "*.home.arpa",
      "*.invalid",
      "+.pool.ntp.org",
      "time.*.com",
      "ntp.*.com",
      "+.music.163.com",
      "+.music.126.net",
      "+.y.qq.com",
      "+.qqmusic.qq.com",
      "+.kugou.com",
      "+.kuwo.cn"
    ]
  },
  "profile": {
    "store-selected": true,
    "store-fake-ip": true
  }
}
