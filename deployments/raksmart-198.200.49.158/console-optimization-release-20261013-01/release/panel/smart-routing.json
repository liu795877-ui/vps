    "Overseas Exceptions": {
      "type": "inline",
      "behavior": "classical",
      "payload": [
        "DOMAIN-SUFFIX,bilibili.tv",
        "DOMAIN-SUFFIX,biliintl.com",
        "PROCESS-NAME,com.bilibili.app.in",
        "PROCESS-NAME,com.bilibili.comic.intl",
        "DOMAIN-SUFFIX,kwai.com",
        "PROCESS-NAME,com.kwai.video"
      ]
    },
    "Domestic Media Supplements": {
      "type": "inline",
      "behavior": "classical",
      "payload": [
        "DOMAIN-SUFFIX,y.qq.com",
        "DOMAIN-SUFFIX,music.qq.com",
        "DOMAIN-SUFFIX,qqmusic.qq.com",
        "DOMAIN-SUFFIX,douyin.com",
        "DOMAIN-SUFFIX,huya.com"
      ]
    }
