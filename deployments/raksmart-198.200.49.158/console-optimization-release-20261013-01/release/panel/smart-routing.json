{
  "name": "智能分流 · 国内直连",
  "sources_checked": "2026-10-09",
  "description": "Private networks and custom overrides first; international variants precede mainland media; independent China domain rules precede resolved China IPs; unmatched traffic follows STATIC-SELECT.",
  "local_rules": [
    "DOMAIN,localhost,DIRECT",
    "DOMAIN-SUFFIX,localhost,DIRECT",
    "DOMAIN-SUFFIX,lan,DIRECT",
    "DOMAIN-SUFFIX,local,DIRECT",
    "DOMAIN-SUFFIX,home.arpa,DIRECT",
    "IP-CIDR,0.0.0.0/8,DIRECT,no-resolve",
    "IP-CIDR,10.0.0.0/8,DIRECT,no-resolve",
    "IP-CIDR,100.64.0.0/10,DIRECT,no-resolve",
    "IP-CIDR,127.0.0.0/8,DIRECT,no-resolve",
    "IP-CIDR,169.254.0.0/16,DIRECT,no-resolve",
    "IP-CIDR,172.16.0.0/12,DIRECT,no-resolve",
    "IP-CIDR,192.168.0.0/16,DIRECT,no-resolve",
    "IP-CIDR,224.0.0.0/4,DIRECT,no-resolve",
    "IP-CIDR,255.255.255.255/32,DIRECT,no-resolve",
    "IP-CIDR6,::/128,DIRECT,no-resolve",
    "IP-CIDR6,::1/128,DIRECT,no-resolve",
    "IP-CIDR6,fc00::/7,DIRECT,no-resolve",
    "IP-CIDR6,fe80::/10,DIRECT,no-resolve",
    "IP-CIDR6,ff00::/8,DIRECT,no-resolve"
  ],
  "rules": [
    "RULE-SET,Overseas Exceptions,STATIC-SELECT",
    "RULE-SET,IQ International,STATIC-SELECT",
    "RULE-SET,WeTV,STATIC-SELECT",
    "RULE-SET,Domestic Media Supplements,DIRECT",
    "RULE-SET,Bilibili,DIRECT",
    "RULE-SET,IQIYI,DIRECT",
    "RULE-SET,Tencent Video,DIRECT",
    "RULE-SET,Youku,DIRECT",
    "RULE-SET,Mango TV,DIRECT",
    "RULE-SET,CCTV,DIRECT",
    "RULE-SET,Douyin,DIRECT",
    "RULE-SET,Kuaishou,DIRECT",
    "RULE-SET,Douyu,DIRECT",
    "RULE-SET,Huya,DIRECT",
    "RULE-SET,Netease Music,DIRECT",
    "RULE-SET,Kugou Kuwo,DIRECT",
    "RULE-SET,Netflix,STATIC-SELECT",
    "RULE-SET,Disney,STATIC-SELECT",
    "RULE-SET,YouTube,STATIC-SELECT",
    "RULE-SET,Telegram,STATIC-SELECT",
    "RULE-SET,Discord,STATIC-SELECT",
    "RULE-SET,AI Services,STATIC-SELECT",
    "RULE-SET,Overseas,STATIC-SELECT",
    "RULE-SET,China Domains,DIRECT",
    "DOMAIN-SUFFIX,cn,DIRECT",
    "RULE-SET,China IPs,DIRECT",
    "MATCH,STATIC-SELECT"
  ],
  "providers": {
    "Bilibili": {
      "type": "http",
      "behavior": "classical",
      "format": "yaml",
      "interval": 86400,
      "path": "./rules/smart/bilibili.yaml",
